{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrendAnalysisInput",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "title"],
        "properties": {
          "event_id": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "item_ids": {"type": "array", "items": {"type": "string"}},
          "source_count": {"type": "integer", "minimum": 0},
          "primary_source_count": {"type": "integer", "minimum": 0},
          "community_signal_count": {"type": "integer", "minimum": 0},
          "repo_signal": {
            "type": "object",
            "properties": {
              "stars_delta": {"type": "integer"},
              "release_activity": {"type": "string"}
            },
            "additionalProperties": true
          },
          "evidence_status": {"type": "string", "enum": ["supported", "mixed", "unclear"]},
          "impact_hints": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
