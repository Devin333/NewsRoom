{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportWritingInput",
  "type": "object",
  "required": ["report", "items"],
  "properties": {
    "report": {
      "type": "object",
      "required": ["title", "audience"],
      "properties": {
        "title": {"type": "string"},
        "audience": {"type": "string"},
        "date": {"type": "string"},
        "style": {"type": "string"}
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "title", "summary", "url", "source_name", "evidence_status"],
        "properties": {
          "item_id": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "url": {"type": "string"},
          "source_name": {"type": "string"},
          "evidence_status": {"type": "string", "enum": ["supported", "contradicted", "unclear"]},
          "trend_score": {"type": "number", "minimum": 0, "maximum": 1},
          "why_it_matters": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "trend_analyses": {
      "type": "array",
      "items": {"type": "object"},
      "default": []
    }
  },
  "additionalProperties": false
}
