{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceReliabilityOutput",
  "type": "object",
  "required": ["reliability_score", "source_tier", "risk_flags", "reasoning_summary", "evidence"],
  "properties": {
    "reliability_score": {"type": "number", "minimum": 0, "maximum": 1},
    "source_tier": {
      "type": "string",
      "enum": ["primary", "trusted_secondary", "secondary", "community", "unverified"]
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "unknown_source",
          "aggregated_without_original",
          "marketing_language",
          "missing_author",
          "missing_date",
          "community_rumor",
          "low_evidence",
          "potential_conflict_of_interest"
        ]
      }
    },
    "reasoning_summary": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "observation"],
        "properties": {
          "field": {"type": "string"},
          "observation": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
