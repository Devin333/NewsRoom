{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventDeduplicationInput",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "url": {"type": "string"},
          "source_name": {"type": "string"},
          "published_at": {"type": "string"},
          "entities": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
